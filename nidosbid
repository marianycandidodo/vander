create database emprega
default character SET utf8mb4
 collate utf8mb4_0900_ai_ci;
 drop database emprega;
 use emprega;
 create table if not exists usuario(
 id bigint primary key auto_increment,
 nome varchar(30),
 email varchar(20),
 senha varchar(20),
 telefone varchar(10),
 cidade varchar (30)
 ) character set utf8mb4;
 describe usuario;
 
