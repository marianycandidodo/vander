create table if not exists vagas(
id bigint primary key auto_increment,
descrição varchar(80),
condição enum ('nativo','ativo'),
salario int,
localização varchar(50),
data_publicada datetime,
id_tabela_empresa bigint,
id_inscrição bigint,
foreign key (id_tabela_empresa) references tabela_empresa(id)
 ) character set utf8mb4;
